# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://avero:avero@localhost:5432/avero?schema=public"
# Direct (non-pooled) connection used by Prisma migrations and the seed.
DIRECT_URL="postgresql://avero:avero@localhost:5432/avero?schema=public"
# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000"
PORT=4000

# JWT (RS256). Generate a pair with `pnpm --filter @avero/api keys:generate`.
# Base64-encoded PEM. The private key signs and never leaves the API;
# anything that only verifies tokens gets JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=