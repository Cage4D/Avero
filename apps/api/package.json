{
  "name": "@avero/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "openapi:export": "prisma generate && tsx scripts/export-openapi.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@avero/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
