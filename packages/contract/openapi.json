{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/models/{code}": {
      "get": {
        "operationId": "ModelsController_findOne",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelDto"
                }
              }
            }
          },
          "404": {
            "description": "No model with this code"
          }
        },
        "tags": [
          "models"
        ]
      }
    }
  },
  "info": {
    "title": "AVERO API",
    "description": "Public API for the AVERO website",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ModelStatus": {
        "type": "string",
        "enum": [
          "live",
          "teaser"
        ]
      },
      "ModelDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "gt"
          },
          "name": {
            "type": "string",
            "example": "AVERO GT"
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ModelStatus"
              }
            ]
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "tagline",
          "status",
          "sortOrder"
        ]
      }
    }
  }
}
